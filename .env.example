# Copy this file to .env.local for local Firebase-backed development.
# Firebase web configuration identifies the public app; it is not authorization.
# Keep service-account credentials and every other server secret out of VITE_*.
# Use Firebase Spark only and do not attach a billing account for the beta.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only Netlify Function credential. Never prefix this with VITE_ and
# never commit a real value. Store the complete service-account JSON as a
# secret environment variable in Netlify.
FIREBASE_SERVICE_ACCOUNT_JSON=
